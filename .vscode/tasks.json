{
    // 统一使用 CMake + Ninja 构建, 产物在 build-cmake/ ; Makefile 仅作上游参考不再使用
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake configure",
            "type": "shell",
            "command": "cmake -S . -B build-cmake -G Ninja",
            "problemMatcher": []
        },
        {
            "label": "build task",
            "type": "shell",
            "command": "cmake --build build-cmake",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "download dap",
            "type": "shell",
            "command": "cmake --build build-cmake ; openocd -f openocd_dap.cfg -c init -c halt -c \"program build-cmake/basic_framework.elf verify reset exit\"",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "log",
            "type": "shell",
            "command": "JlinkRTTClient",
            "args": [],
            "problemMatcher": []
            // 使用前需安装 SEGGER J-Link (RTT 日志)
        }
    ]
}
